flowchart TD

    %% ===================================================================
    %% PHASE 1: DATA GENERATION
    %% ===================================================================
    subgraph P1["<b>PHASE 1 — DATA GENERATION</b> &lt;data_gen.py&gt;"]
        direction LR
        CFG["<b>experiment_config.py</b><br/>MODEL = gpt2-small<br/>TOKEN_POSITION = mean<br/>CONCEPTS = 22 categories<br/>LAYERS = [6, 9, 10]<br/>METHODS = [mean_diff, svm]"]
        NODES["<b>Curated Concept Nodes</b><br/>time: hour, minute, day…<br/>place: city, town, park…<br/>tool: hammer, wrench…<br/>WordNet hypernym validation<br/>Frequency/length matching"]
        SENTS["<b>Sentence Generation</b><br/>CORPUS_MODE = corpus<br/>Sources: Brown, Gutenberg<br/>SVO structure required<br/>subj:35% obj:35% prep:30%<br/>Length: 8–20 words"]
        DATA["<b>experiment_data.json</b><br/>cav_training.positive: [sents]<br/>cav_training.negative: [sents]<br/>r1_benchmark: [items]<br/>r2_benchmark: [pairs]"]
        CFG --> NODES --> SENTS --> DATA
    end

    %% ===================================================================
    %% PHASE 2: DATA VALIDATION
    %% ===================================================================
    subgraph P2["<b>PHASE 2 — DATA VALIDATION</b> &lt;validation_tests.py --no-model&gt;"]
        direction LR
        T01["<b>[T01]</b> ConceptNet Quality<br/>≥ 20 nodes/category"]
        T02["<b>[T02]</b> Neg. Contamination<br/>ratio &lt; 0.05"]
        T03["<b>[T03]</b> Polysemy Check<br/>overlap &lt; 0.08"]
        T04["<b>[T04]</b> Sample Size<br/>≥ 30 mean_diff<br/>≥ 100 SVM"]
        T05["<b>[T05]</b> Tokenization<br/>≥ 80% single-token"]
        T06["<b>[T06]</b> Template Artifacts<br/>permutation test"]
    end

    %% ===================================================================
    %% PHASE 3: ACTIVATION COLLECTION
    %% ===================================================================
    subgraph P3["<b>PHASE 3 — ACTIVATION COLLECTION</b> &lt;cav_extraction.py&gt;"]
        direction LR
        MODEL["<b>Load Model</b><br/>HookedTransformer.from_pretrained<br/>gpt2-small · d_model=768<br/>model.eval()"]
        COLLECT["<b>collect_activations(model, sentences, layer)</b><br/>FOR EACH sentence:<br/>  1. model.run_with_cache(sent)<br/>  2. hook = blocks.L.hook_resid_post<br/>  3. act = cache[hook] → [1, seq_len, 768]<br/>  4. mean pooling → act[0].mean(dim=0) → [768]<br/>  5. activations.append(pooled.cpu())<br/>RETURN torch.stack → [N, 768]"]
        ACTS["<b>Saved Activations</b><br/>pos_acts: [N_pos, 768]<br/>neg_acts: [N_neg, 768]<br/>{concept}_acts_layer{L}.pt"]
        DIAG["<b>Layer Diagnostic (optional)</b><br/>LogisticRegression probe × 12 layers<br/>3-fold CV → rank by accuracy<br/>Top-3 empirical layers"]
        T07["<b>[T07]</b> Layer Validity<br/>above_chance ≥ 0.60<br/>top-k = 6"]
        MODEL --> COLLECT --> ACTS
        COLLECT --> DIAG --> T07
    end

    %% ===================================================================
    %% PHASE 4: CAV EXTRACTION
    %% ===================================================================
    subgraph P4["<b>PHASE 4 — CAV EXTRACTION</b> &lt;cav_extraction.py&gt;"]
        direction TB

        subgraph METHODS["Extraction Methods"]
            direction LR
            MD["<b>Method 1: Mean Difference</b><br/>mean_pos = pos_acts.mean(dim=0)<br/>mean_neg = neg_acts.mean(dim=0)<br/>cav = normalize(mean_pos − mean_neg)<br/>ASSERT: norm > 1e-8<br/>ASSERT: |cav.norm() − 1| &lt; 1e-5"]
            SVM["<b>Method 2: Linear SVM</b><br/>Kim et al. 2018<br/>X = cat([pos, neg]) → [N, 768]<br/>y = [1]*N_pos + [0]*N_neg<br/>IF SVM_TUNE_C: GridSearch C=[0.01..10]<br/>  5-fold StratifiedKFold CV<br/>clf = LinearSVC(C=best_C, max_iter=10000)<br/>cav = normalize(clf.coef_[0])<br/>Convergence: n_iter &lt; max_iter"]
        end

        COHEND_E["<b>Cohen's d (at extraction)</b><br/>pos_proj = pos @ cav<br/>neg_proj = neg @ cav<br/>d = (μ_pos − μ_neg) / σ_pooled<br/>Hedges' g · Levene · t-test · 95% CI"]
        T08["<b>[T08]</b> SVM CV Acc ≥ 0.70"]
        T15E["<b>[T15]</b> Effect Size |d| ≥ 0.8"]

        subgraph OUTPUTS["CAV Outputs"]
            direction LR
            FILES["<b>CAV Files</b><br/>{concept}_{method}_layer{L}.pt<br/>→ unit vector [768]<br/>extraction_report.json"]
            XCONCEPT["<b>Cross-Concept Cosine</b><br/>cos(cav_time, cav_place)<br/>cos(cav_time, cav_tool)<br/>cos(cav_place, cav_tool)"]
            XMETHOD["<b>Cross-Method Cosine</b><br/>cos(cav_mean_diff, cav_svm)<br/>per concept × layer"]
            T09["<b>[T09]</b> |cos| &lt; 0.35"]
        end

        METHODS --> COHEND_E
        SVM --> T08
        COHEND_E --> T15E
        METHODS --> OUTPUTS
        XCONCEPT --> T09
    end

    %% ===================================================================
    %% PHASE 5: STATISTICAL VALIDATION
    %% ===================================================================
    subgraph P5["<b>PHASE 5 — STATISTICAL VALIDATION</b> &lt;cav_statistical_tests.py&gt;"]
        direction TB

        subgraph TESTS["4 Statistical Tests (per concept × layer × method)"]
            direction LR

            TCAV["<b>Test 1: TCAV Permutation</b><br/>Kim et al. 2018, Section 4<br/>━━━━━━━━━━━━━━━━━━━━<br/>1. Split 70% train / 30% test<br/>2. Re-extract CAV from TRAIN<br/>3. TCAV = frac(dot(act,cav)>0)<br/>   score on TEST only<br/>4. 30 random CAVs (shuffled)<br/>5. p = frac(random ≥ real)<br/>━━━━━━━━━━━━━━━━━━━━<br/>GPU-accelerated SVM"]

            SEL["<b>Test 2: Selectivity</b><br/>Hewitt & Liang 2019<br/>━━━━━━━━━━━━━━━━━━━━<br/>1. real_acc = CV(pos, neg)<br/>2. FOR 5 control runs:<br/>   shuffle labels → ctrl_acc<br/>3. selectivity =<br/>   real_acc − mean(ctrl_acc)<br/>━━━━━━━━━━━━━━━━━━━━<br/>≥0.30 strong evidence"]

            CD["<b>Test 3: Cohen's d</b><br/>Cohen 1988<br/>━━━━━━━━━━━━━━━━━━━━<br/>d = (μ_pos − μ_neg) / σ_pooled<br/>Hedges' g = d×(1−3/(4N−9))<br/>Levene → var equality<br/>Student or Welch t-test<br/>95% CI approximation<br/>━━━━━━━━━━━━━━━━━━━━<br/>&lt;0.2 negligible · ≥0.8 large"]

            BOOT["<b>Test 4: Bootstrap CI</b><br/>Efron & Tibshirani 1993<br/>━━━━━━━━━━━━━━━━━━━━<br/>1. Extract original CAV<br/>2. 200–1000 resamples:<br/>   resample with replacement<br/>   extract boot_cav<br/>   cos_sim(orig, boot)<br/>3. BCa CI (bias-corrected<br/>   accelerated, Ch.14)<br/>━━━━━━━━━━━━━━━━━━━━<br/>Batched GPU SVM"]
        end

        subgraph THRESHOLDS["Test Thresholds"]
            direction LR
            T13["<b>[T13]</b> TCAV<br/>p &lt; 0.05"]
            T14["<b>[T14]</b> Selectivity<br/>≥ 0.10"]
            T15["<b>[T15]</b> Cohen's d<br/>|d| ≥ 0.8 large<br/>|d| ≥ 0.5 medium"]
            T16["<b>[T16]</b> Bootstrap CI<br/>CI_lower ≥ 0.69<br/>≥0.90 very stable"]
        end

        STAT_OUT["<b>statistical_validation.json</b><br/>Per concept × layer × method"]

        TCAV --> T13
        SEL --> T14
        CD --> T15
        BOOT --> T16
        THRESHOLDS --> STAT_OUT
    end

    %% ===================================================================
    %% PHASE 5.5: REFINEMENT (optional)
    %% ===================================================================
    subgraph P55["<b>PHASE 5.5 — CAV REFINEMENT (optional)</b> &lt;refine_cavs.py&gt; · USE_REFINED_CAVS=False"]
        direction LR
        REFINE["<b>Orthogonal Subspace Projection</b><br/>v_pure = v_A − V(V<sup>T</sup>V)<sup>−1</sup>V<sup>T</sup>v_A<br/>V = [v_B | v_C | …] other CAVs<br/>Removes cross-concept interference<br/>ASSERT: residual norm ≥ 0.1<br/>Re-normalize to unit vector"]
    end

    %% ===================================================================
    %% PHASE 6: EXPERIMENTAL APPLICATION
    %% ===================================================================
    subgraph P6["<b>PHASE 6 — EXPERIMENTAL APPLICATION</b> &lt;experiment_runner.py&gt;"]
        direction LR
        HOOK["<b>Ablation Hook</b><br/>ablation_hook(resid, cav, α, tech):<br/>━━━━━━━━━━━━━━━━━━━━<br/><b>subtraction:</b><br/>  resid −= α × cav<br/><b>projection:</b><br/>  proj = (resid · cav) × cav<br/>  resid −= α × proj"]
        FACTORIAL["<b>Factorial Experiment</b><br/>22 Concepts × 2 Techniques<br/>× 4 Intensities (α ∈ {0, 1.5, 3.5, 6})<br/>R1: Category membership<br/>R2: Semantic similarity<br/>→ results_factorial.csv"]
        REMOVAL["<b>Concept Removal Check</b><br/>measure_concept_removal():<br/>dot_pre = act_pre · cav<br/>dot_post = act_post · cav<br/>ratio = 1 − (dot_post/dot_pre)<br/>WARNING if ratio &lt; 0.5"]
        T17["<b>[T17]</b> Dose-response<br/>monotonic ≥ 70%"]
        T18["<b>[T18]</b> CI width<br/>R1 ≤ 0.35 · R2 ≤ 0.10"]
        HOOK --> FACTORIAL
        HOOK --> REMOVAL
        FACTORIAL --> T17
        FACTORIAL --> T18
    end

    %% ===================================================================
    %% FLOW CONNECTIONS
    %% ===================================================================
    P1 ==>|"validate data"| P2
    P2 ==>|"load model + extract"| P3
    P3 ==>|"activations"| P4
    P4 ==>|"CAVs + activations"| P5
    P5 ==>|"validated CAVs"| P55
    P55 ==>|"final CAVs"| P6
