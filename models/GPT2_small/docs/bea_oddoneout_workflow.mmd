%%{init: {
  "theme": "base",
  "themeVariables": {
    "primaryColor": "#FFFFFF",
    "primaryTextColor": "#000000",
    "primaryBorderColor": "#000000",
    "secondaryColor": "#F5F5F5",
    "tertiaryColor": "#EEEEEE",
    "lineColor": "#000000",
    "fontSize": "13px",
    "fontFamily": "Times New Roman, serif"
  }
}}%%

flowchart TD
    %% ===================================================================
    %% BEA ODD-ONE-OUT TEST WORKFLOW
    %% ===================================================================
    
    subgraph INPUTS["1. Inputs & Benchmarks"]
        direction LR
        BM_JSON["bea_oddoneout_benchmark.json\n\nLists of 4 items:\n3 semantically related\n1 semantic intruder"]
        CAT_MAP["Category Mapping\n\nHierarchical mapping of concepts to\nfields (e.g., baker -> professions)"]
        MODEL["GPT-2 Small Model"]
        
        BM_JSON --> LOADER
        CAT_MAP --> LOADER
        MODEL --> LOADER
    end

    subgraph ENGINE["2. Execution Engine (bea_oddoneout_test.py)"]
        direction TB
        LOADER["Load Benchmark & Concepts"]
        
        subgraph LOOP["Iterative Ablation Matrix"]
            direction TB
            COND["Iterate:\nConcepts x Methods x Layers x Alphas"]
            
            ABLATE["Intercept Residual Stream\n\nProject out the CAV from the target layer"]
            
            EVALUATE["Intruder Detection Prompt\n\n'In the list [A, B, C, D], the one that does not belong is ___'\nScore logic compares log-prob of true intruder\nagainst the category members."]
            
            COND --> ABLATE --> EVALUATE
        end
        
        LOADER --> LOOP
    end

    subgraph METRICS["3. Distractor Impact"]
        direction TB
        ACC_SCORE["Calculate Detect Accuracy\n\nIs the intruder cleanly identified?"]
        
        ON_OFF["Identify Lesion Scope\n\nOn-Target: The true category is ablated.\nOff-Target: Unrelated category is ablated."]
        
        SPEC["Delta Discrepancy\n\nObserve how much harder it is to find\nthe intruder when the background semantic field\nis damaged by the CAV."]
        
        EVALUATE --> ACC_SCORE --> ON_OFF --> SPEC
    end
    
    subgraph OUTPUTS["4. Results Export"]
        direction LR
        JSON_OUT["bea_oddoneout_test_results.json\n\nReady for plotting and ANOVA analysis."]
        SPEC --> JSON_OUT
    end

    %% STYLES
    classDef default fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000000
    classDef input fill:#F5F5F5,stroke:#000000,stroke-width:2px,color:#000000
    classDef output fill:#E0E0E0,stroke:#000000,stroke-width:2px,color:#000000
    
    class BM_JSON,CAT_MAP,MODEL input
    class JSON_OUT output
