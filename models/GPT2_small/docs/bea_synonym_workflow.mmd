%%{init: {
  "theme": "base",
  "themeVariables": {
    "primaryColor": "#FFFFFF",
    "primaryTextColor": "#000000",
    "primaryBorderColor": "#000000",
    "secondaryColor": "#F5F5F5",
    "tertiaryColor": "#EEEEEE",
    "lineColor": "#000000",
    "fontSize": "13px",
    "fontFamily": "Times New Roman, serif"
  }
}}%%

flowchart TD
    %% ===================================================================
    %% BEA SYNONYM TEST WORKFLOW
    %% ===================================================================
    
    subgraph INPUTS["1. Inputs & Benchmarks"]
        direction LR
        BM_JSON["bea_synonym_benchmark.json\n\nContains pairs of:\n- Target Concept (e.g., 'tailor')\n- Synonyms ('garmentmaker')\n- Antonyms ('destroyer')"]
        MODEL["GPT-2 Small Model\n\nLoaded with TransformerLens"]
        CAVS["Validated CAVs\n\nExtracted tensors (.pt)"]
        
        BM_JSON --> LOADER
        MODEL --> LOADER
        CAVS --> LOADER
    end

    subgraph ENGINE["2. Execution Engine (bea_synonym_test.py)"]
        direction TB
        LOADER["Load Benchmark & Concepts\n\nFilters concepts with min 5 correct baseline items."]
        
        subgraph LOOP["Iterative Ablation Matrix"]
            direction TB
            COND["For each:\n- Concept\n- CAV Method (Mean Diff, SVM)\n- Layer (6, 9, 10, all_layers)\n- Alpha (3.0, 6.0, 10.0, 15.0, 20.0)"]
            
            ABLATE["Apply Ablation Hook\n\nresid_post -= alpha * proj(resid, CAV)"]
            
            EVALUATE["Evaluate Item\n\nFormat: 'A ___ is the same as a tailor'\nCompare probabilities:\n P(Synonym) vs P(Antonym)"]
            
            COND --> ABLATE --> EVALUATE
        end
        
        LOADER --> LOOP
    end

    subgraph METRICS["3. Automated Metrics"]
        direction TB
        CALC_AUC["Calculate AUC (Area Under Curve)\n\nThreshold-independent metric of\nsynonym/antonym discriminability.\nEvaluated per concept."]
        
        CALC_GAP["Calculate Log-Prob Gap\n\nMean P(Synonym) - Mean P(Antonym)"]
        
        baseline["Baseline Metrics\n\nModel performance without CAV hooks"]
        
        baseline --> CALC_AUC
        EVALUATE --> CALC_GAP
        CALC_GAP --> CALC_AUC
    end
    
    subgraph OUTPUTS["4. Results Export"]
        direction LR
        JSON_OUT["bea_synonym_test_results.json\n\nStores on-target / off-target Deltas,\nAUC scores, and full factorial matrix\nfor ANOVA regression."]
        CALC_AUC --> JSON_OUT
    end

    %% STYLES
    classDef default fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000000
    classDef input fill:#F5F5F5,stroke:#000000,stroke-width:2px,color:#000000
    classDef output fill:#E0E0E0,stroke:#000000,stroke-width:2px,color:#000000
    
    class BM_JSON,MODEL,CAVS input
    class JSON_OUT output
