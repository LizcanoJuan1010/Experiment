    classDef default fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000000
    classDef titulo fill:#F0F0F0,stroke:#000000,stroke-width:2px,color:#000000
    classDef phase fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000000
    classDef output fill:#F0F0F0,stroke:#000000,stroke-width:2px,color:#000000

    class TITULO titulo
    class F1,F2,F3,F4,F5,F6,F7,F8,F9,F10 phase
    class EXPDATA,CAV_FILES,FACTORIAL_OUT,CCT_OUT,SYN_OUT,NAM_OUT,CAP_OUT,BASE_OUT output
